# Required
GROQ_API_KEY=your_groq_key_here

# Optional: enables live Google result snippets for current news, trends, memes, etc.
# Create a Programmable Search Engine and put its Search Engine ID in GOOGLE_SEARCH_ENGINE_ID.
GOOGLE_SEARCH_API_KEY=if_ypu_have_one
GOOGLE_SEARCH_ENGINE_ID=if_ypu_have_one

# Optional runtime controls
NODE_ENV=production
PORT=3000
APP_TIMEZONE=Asia/Kolkata
SESSION_TTL_HOURS=24
MAX_HISTORY_MESSAGES=32
MAX_HISTORY_CHARS=60000
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_SIDE=2048
